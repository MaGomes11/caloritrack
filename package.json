    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.34.0",
    "mysql2": "^3.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
